{
  "name": "drocsid",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "Salas de texto, voz e compartilhamento de tela para pequenos grupos",
  "author": "Conversa",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && node scripts/prepare-electron.mjs && node scripts/build-windows.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "vite": "^7.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.conversa.desktop",
    "productName": "Conversa",
    "electronDist": ".packaging/electron",
    "directories": {
      "output": "release-windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/service.js",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Conversa-${version}-Windows.exe"
    }
  },
  "workspaces": [
    "apps/*"
  ]
}
