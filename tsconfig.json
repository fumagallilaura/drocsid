{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts"],
  "exclude": ["node_modules", "apps", "dist", "release", "release-windows", ".packaging"]
}
